{
  "backend": "word_to_line",
  "word_backend": "trocr",
  "model_dir": "scratch/ocr-recognizers/models/trocr_thaito98",
  "segmentation_cache": "scratch/ocr-recognizers/word-cache-projection-v1",
  "device": "cuda",
  "max_batch_size": 16,
  "word_batch_size": 8,
  "max_new_tokens": 64,
  "gap_height_ratio": 0.18,
  "pad_px": 1,
  "dtype": "float32",
  "runtime": {
    "env": {"TORCH_DISABLE_NATIVE_JIT": "1"},
    "ipc_batch_size": 32,
    "timeout_seconds": 900
  }
}
